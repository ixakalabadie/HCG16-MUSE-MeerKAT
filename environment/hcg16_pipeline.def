Bootstrap: docker
From: ubuntu:20.04

%labels
    Author Ixaka Labadie García
    Version 1.0
    Description "Singularity container to process HCG16 MUSE and MeerKAT data"

%environment
    export LC_ALL=C
    export PATH=/usr/local/bin:$PATH
    export SOFIA2_HOME=/opt/sofia2

    # exports for miriad
    export MIR=/opt/miriad
    export MIRBIN=$MIR/bin/linux
    export MIRLIB=$MIR/lib/linux
    export MIRPDOC=$MIR/doc/prog
    export MIRSDOC=$MIR/doc/subs
    export MIRHOST=linux
    export MIRXINC=/usr/include/X11
    export MIRXLIB=/usr/X11R6/lib
    export AIPSTV=XASIN
    export PATH=$MIRBIN:$PATH
    export LD_LIBRARY_PATH=$MIRLIB:$LD_LIBRARY_PATH
    export PGPLOT_DIR=$MIRLIB


%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    # SoFiA2 prerequisites
    apt-get install -y \
	wget \
	gcc \
	make \
	wcslib-dev

    # Miriad prerequisites
    apt-get install -y \
	git \
	tcsh \
	build-essential \
	gfortran \
	xorg-dev \
	libreadline6-dev
    apt-get install -y \
	pgplot5 \
	automake \
	libtool \
	flex

    apt-get install -y \
	python3 \
	python3-pip \
	nano

    # Install python packages
    pip3 install numpy scipy astropy matplotlib pandas photutils multiprocess lmfit tqdm visl3d anywidget

    # Install SoFiA2
    mkdir -p /opt/sofia2
    cd /opt/sofia2
    wget https://gitlab.com/SoFiA-Admin/SoFiA-2/-/archive/v2.6.0/SoFiA-2-v2.6.0.tar.gz
    tar -xvzf SoFiA-2-v2.6.0.tar.gz
    rm SoFiA-2-v2.6.0.tar.gz
    cd SoFiA-2-v2.6.0
    make -j$(nproc) OMP=-fopenmp
    make clean
    cp sofia /usr/local/bin

    # Install Miriad
    cd /opt
    git clone https://github.com/astroumd/miriad
    cd miriad
    install/install.miriad gfortran=1 generic=1 gif=1 telescope=carma
